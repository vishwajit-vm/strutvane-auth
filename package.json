{
  "name": "@strutvane/auth",
  "version": "0.1.0-next.0",
  "description": "Enterprise authentication and authorization for TypeScript apps: policies compiled to SQL, multi-tenancy with Postgres RLS, hardened identity adapters, audit events and framework-agnostic middleware.",
  "keywords": [
    "strutvane",
    "typescript",
    "authentication",
    "authorization",
    "rbac",
    "abac",
    "multi-tenancy",
    "row-level-security",
    "audit-log",
    "better-auth"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-auth#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-auth.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./sql": {
      "types": "./dist/sql.d.mts",
      "default": "./dist/sql.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "default": "./dist/postgres.mjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.mts",
      "default": "./dist/sqlite.mjs"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.mts",
      "default": "./dist/better-auth.mjs"
    },
    "./hono": {
      "types": "./dist/hono.d.mts",
      "default": "./dist/hono.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "default": "./dist/provider.mjs"
    },
    "./admin": {
      "types": "./dist/admin.d.mts",
      "default": "./dist/admin.mjs"
    },
    "./commands": {
      "types": "./dist/commands.d.mts",
      "default": "./dist/commands.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "migrations",
    "migrations-better-auth"
  ],
  "engines": {
    "node": ">=24.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "peerDependencies": {
    "@strutvane/framework": "^0.1.0-next.1",
    "better-auth": "1.7.23",
    "hono": "^4.13.0",
    "pg": "^8.23.0",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@electric-sql/pglite": "0.5.16",
    "@strutvane/framework": "0.1.0-next.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "better-auth": "1.7.23",
    "fast-check": "4.10.2",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  },
  "strutvane": {
    "commands": "./dist/commands.mjs",
    "compat": "^0.1.0-next.0",
    "migrations": "./migrations"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0"
  }
}
